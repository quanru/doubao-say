+# Fixed start deadlines include successful read time, skip missed periods, and
+# keep only one timer. Failures and absent owners must not busy-poll.
+def deadline_case(read_us, should_fail=False):
+  timer_calls, removed, hooks, ticks = [], [], {}, [0]
+  live_reader = indicator.Indicator(None)
+  def read_state():
+    ticks[0] += read_us
+    if should_fail:
+      raise indicator.GLib.Error("stalled service")
+    return dict(state)
+  live_reader.refresh = read_state
+  def timeout_ms(delay, callback):
+    timer_calls.append((delay, callback))
+    return len(timer_calls)
+  def follow_bus(bus, changed, presence):
+    hooks.update(changed=changed, presence=presence)
+    return []
+  def check():
+    expected = 2000 if should_fail else 200 - (read_us // 1000) % 200
+    assert timer_calls[-1][0] == expected, timer_calls
+    live_reader.pending, live_reader.last, live_reader.entries = "pinyin", "pinyin", {"old": ()}
+    hooks["presence"](False)
+    assert removed == [1] and not live_reader.pending and not live_reader.last and not live_reader.entries
+    hooks["changed"]()
+    assert timer_calls[-1][0] == 200
+    before = ticks[0]
+    timer_calls[-1][1]()
+    assert ticks[0] == before, "absent owner was queried"
+    assert len(timer_calls) == 2, "absent owner scheduled polling"
+    hooks["presence"](True)
+    hooks["changed"]()
+    timer_calls[-1][1]()
+    assert ticks[0] > before, "replacement owner was not read"
+    assert len(timer_calls) == 4
+  loop = Mock()
+  loop.run.side_effect = check
+  with patch.object(indicator, "Indicator", return_value=live_reader), \
+       patch.object(indicator.GLib, "MainLoop", return_value=loop), \
+       patch.object(indicator.GLib, "io_add_watch"), \
+       patch.object(indicator.GLib, "timeout_add", side_effect=timeout_ms), \
+       patch.object(indicator.GLib, "source_remove", side_effect=removed.append), \
+       patch.object(indicator.GLib, "get_monotonic_time", side_effect=lambda: ticks[0]), \
+       patch.object(indicator, "follow", side_effect=follow_bus), patch("builtins.print"):
+    indicator.watch(None)
+for read_us in [50000, 450000]:
+  deadline_case(read_us)
+deadline_case(1000000, should_fail=True)
+print("ok - refresh cost is inside the polling deadline; missed periods are skipped; failures back off")
+print("ok - absent owners cancel polling and clear queued selection and metadata; replacements resume")
+
