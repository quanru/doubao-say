[Unit]
Description=豆包说 (Doubao Say)
Documentation=https://doubao-say.lifeos.md/guide/install
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/doubao-say
Restart=on-failure
RestartSec=3

# Wayland / X11 都需要
Environment=DISPLAY=:0
Environment=GDK_BACKEND=wayland,x11
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
